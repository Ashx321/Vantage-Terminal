# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — it will never be committed.
#
# Find both values in your Supabase project:
# Project Settings -> API -> Project URL / Project API keys -> anon public
#
# The "anon" key is NOT secret in the traditional sense — it's designed to be
# shipped in browser code. Your data stays safe because of Row Level Security
# (RLS) policies on each table (see supabase/schema.sql), not because this key
# is hidden. Never use the "service_role" key anywhere in frontend code, though
# — that one bypasses RLS entirely and must never leave a trusted server.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
